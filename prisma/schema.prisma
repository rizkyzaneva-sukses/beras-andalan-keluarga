generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  KASIR
}

enum KategoriPembelanjaan {
  RESTOCK
  OPERASIONAL
  LAINNYA
}

enum MetodeBayar {
  CASH
  TRANSFER
  QRIS
  HUTANG
}

enum StatusBayar {
  CASH
  KREDIT
}

enum TipeProduk {
  KARUNG
  ECERAN
  GABUNGAN
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String   @map("password_hash")
  role         Role
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  penjualan         Penjualan[]
  pembelanjaan      Pembelanjaan[]
  modalLog          ModalLog[]
  auditLog          AuditLog[]
  pembayaranUtang   PembayaranUtang[]
  piutang           Piutang[]
  pembayaranPiutang PembayaranPiutang[]
  stokAdjustment    StokAdjustment[]

  @@map("user")
}

model Produk {
  id              String       @id @default(cuid())
  nama            String
  satuan          String
  hargaBeli       Int          @map("harga_beli")
  hargaJual       Int          @map("harga_jual")
  stok            Decimal      @default(0) @db.Decimal(12, 3)
  hppRataRata     Int          @default(0) @map("hpp_rata_rata")
  aktif           Boolean      @default(true)
  tipe            TipeProduk   @default(KARUNG)
  isiPerKarung    Decimal?     @map("isi_per_karung") @db.Decimal(12, 3)
  sumberProdukId  String?      @map("sumber_produk_id")
  createdAt       DateTime     @default(now()) @map("created_at")

  sumberProduk     Produk?            @relation("EceranSumber", fields: [sumberProdukId], references: [id])
  eceranDariProduk Produk[]           @relation("EceranSumber")
  komposisiResep   KomposisiProduk[]  @relation("KomposisiResep")
  komposisiSumber  KomposisiProduk[]  @relation("KomposisiSumber")
  penjualan        Penjualan[]
  pembelanjaan     Pembelanjaan[]
  stokAdjustment   StokAdjustment[]

  @@map("produk")
}

model KomposisiProduk {
  id          String   @id @default(cuid())
  produkId    String   @map("produk_id")
  sumberId    String   @map("sumber_id")
  qtyPerBatch Decimal  @map("qty_per_batch") @db.Decimal(12, 3)

  produk Produk @relation("KomposisiResep", fields: [produkId], references: [id], onDelete: Cascade)
  sumber Produk @relation("KomposisiSumber", fields: [sumberId], references: [id])

  @@unique([produkId, sumberId])
  @@map("komposisi_produk")
}

model ModalLog {
  id         String   @id @default(cuid())
  jumlah     Int
  tanggal    DateTime
  keterangan String?
  createdBy  String   @map("created_by")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [createdBy], references: [id])

  @@map("modal_log")
}

model Pembelanjaan {
  id            String               @id @default(cuid())
  tanggal       DateTime
  kategori      KategoriPembelanjaan
  namaBarang    String               @map("nama_barang")
  jumlah        Decimal              @db.Decimal(12, 3)
  harga         Int
  total         Int
  statusBayar   StatusBayar          @default(CASH) @map("status_bayar")
  sudahDibayar  Int                  @default(0) @map("sudah_dibayar")
  produkId      String?              @map("produk_id")
  createdBy     String               @map("created_by")
  createdAt     DateTime             @default(now()) @map("created_at")

  user            User              @relation(fields: [createdBy], references: [id])
  produk          Produk?           @relation(fields: [produkId], references: [id])
  pembayaranUtang PembayaranUtang[]

  @@map("pembelanjaan")
}

model Penjualan {
  id                String      @id @default(cuid())
  tanggal           DateTime
  produkId          String      @map("produk_id")
  qty               Decimal     @db.Decimal(12, 3)
  hargaJual         Int         @map("harga_jual")
  total             Int
  metodeBayar       MetodeBayar @map("metode_bayar")
  hargaDisesuaikan  Boolean     @default(false) @map("harga_disesuaikan")
  namaPelanggan     String?     @map("nama_pelanggan")
  piutangId         String?     @map("piutang_id")
  createdBy         String      @map("created_by")
  createdAt         DateTime    @default(now()) @map("created_at")

  produk  Produk   @relation(fields: [produkId], references: [id])
  user    User     @relation(fields: [createdBy], references: [id])
  piutang Piutang? @relation(fields: [piutangId], references: [id])

  @@map("penjualan")
}

model AuditLog {
  id         String   @id @default(cuid())
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  action     String
  oldData    String?  @map("old_data")
  newData    String?  @map("new_data")
  userId     String   @map("user_id")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("audit_log")
}

model PembayaranUtang {
  id              String   @id @default(cuid())
  pembelanjaanId  String   @map("pembelanjaan_id")
  jumlah          Int
  tanggal         DateTime
  createdBy       String   @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at")

  pembelanjaan Pembelanjaan @relation(fields: [pembelanjaanId], references: [id])
  user         User         @relation(fields: [createdBy], references: [id])

  @@map("pembayaran_utang")
}

model Piutang {
  id            String   @id @default(cuid())
  namaPelanggan String   @map("nama_pelanggan")
  tanggal       DateTime
  total         Int
  sudahDibayar  Int      @default(0) @map("sudah_dibayar")
  keterangan    String?
  createdBy     String   @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")

  user       User                 @relation(fields: [createdBy], references: [id])
  penjualan  Penjualan[]
  pembayaran PembayaranPiutang[]

  @@map("piutang")
}

model StokAdjustment {
  id         String   @id @default(cuid())
  produkId   String   @map("produk_id")
  stokSistem Decimal  @map("stok_sistem") @db.Decimal(12, 3)
  stokFisik  Decimal  @map("stok_fisik") @db.Decimal(12, 3)
  selisih    Decimal  @db.Decimal(12, 3)
  alasan     String
  createdBy  String   @map("created_by")
  createdAt  DateTime @default(now()) @map("created_at")

  produk Produk @relation(fields: [produkId], references: [id])
  user   User   @relation(fields: [createdBy], references: [id])

  @@index([produkId])
  @@index([createdAt])
  @@map("stok_adjustment")
}

model PembayaranPiutang {
  id          String      @id @default(cuid())
  piutangId   String      @map("piutang_id")
  jumlah      Int
  tanggal     DateTime
  metodeBayar MetodeBayar @map("metode_bayar")
  createdBy   String      @map("created_by")
  createdAt   DateTime    @default(now()) @map("created_at")

  piutang Piutang @relation(fields: [piutangId], references: [id])
  user    User    @relation(fields: [createdBy], references: [id])

  @@map("pembayaran_piutang")
}

model Pengaturan {
  id        String   @id @default("default")
  namaToko  String   @default("Beras Andalan") @map("nama_toko")
  slogan    String?  @default("Toko beras keluarga") @map("slogan")
  logoText  String?  @default("B") @map("logo_text")
  logoColor String?  @default("#15803d") @map("logo_color")
  logoUrl   String?  @map("logo_url")
  alamat    String?  @map("alamat")
  telepon   String?  @map("telepon")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("pengaturan")
}

